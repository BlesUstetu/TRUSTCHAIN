# Dedicated Trustchain Supabase project only
NEXT_PUBLIC_SUPABASE_URL=
# Preferred key for browser + SSR clients (new Supabase key format)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also supported if publishable key is not available
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Base RPC endpoint. Use a provider with suitable rate limits.
BASE_RPC_URL=

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
